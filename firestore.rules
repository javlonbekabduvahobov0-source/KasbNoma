rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'grade',
          'favoriteSubjectId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'grade',
          'favoriteSubjectId',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && data.grade in ['10', '11']
        && data.favoriteSubjectId is string
        && data.favoriteSubjectId.size() >= 1
        && data.favoriteSubjectId.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTestResult(data) {
      return data.keys().hasAll([
          'userId',
          'subjectId',
          'subjectName',
          'score',
          'totalQuestions',
          'percent',
          'dtmEquivalent',
          'mode',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'subjectId',
          'subjectName',
          'score',
          'totalQuestions',
          'percent',
          'dtmEquivalent',
          'mode',
          'createdAt'
        ])
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.subjectId is string
        && data.subjectId.size() >= 1
        && data.subjectId.size() <= 64
        && data.subjectName is string
        && data.subjectName.size() >= 1
        && data.subjectName.size() <= 80
        && data.score is int
        && data.totalQuestions is int
        && data.totalQuestions >= 1
        && data.totalQuestions <= 100
        && data.score >= 0
        && data.score <= data.totalQuestions
        && data.percent is int
        && data.percent >= 0
        && data.percent <= 100
        && data.dtmEquivalent is number
        && data.dtmEquivalent >= 0
        && data.dtmEquivalent <= 189
        && data.mode in ['demo', 'ai']
        && data.createdAt is timestamp;
    }

    function isValidSavedRoadmap(data) {
      return data.keys().hasAll([
          'userId',
          'subject',
          'summaryTitle',
          'targetIncomeMillion',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'subject',
          'summaryTitle',
          'targetIncomeMillion',
          'createdAt'
        ])
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.subject is string
        && data.subject.size() >= 1
        && data.subject.size() <= 80
        && data.summaryTitle is string
        && data.summaryTitle.size() >= 1
        && data.summaryTitle.size() <= 200
        && data.targetIncomeMillion is number
        && data.targetIncomeMillion >= 1
        && data.targetIncomeMillion <= 200
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'grade',
          'favoriteSubjectId',
          'updatedAt'
        ]);
      allow delete: if false;

      match /testResults/{resultId} {
        allow get: if isValidId(userId) && isValidId(resultId) && isOwner(userId);
        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.userId == request.auth.uid;
        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(resultId)
          && isOwner(userId)
          && isValidTestResult(incoming())
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(resultId)
          && isOwner(userId);
      }

      match /roadmaps/{roadmapId} {
        allow get: if isValidId(userId) && isValidId(roadmapId) && isOwner(userId);
        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.userId == request.auth.uid;
        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(roadmapId)
          && isOwner(userId)
          && isValidSavedRoadmap(incoming())
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(roadmapId)
          && isOwner(userId);
      }
    }
  }
}
